# Phase 0 — pile NimBLE, role central, L2CAP CoC client
# Base copiee de examples/bluetooth/nimble/ble_l2cap_coc/coc_blecent, adaptee pour 2 canaux
# audio simultanes (une connexion CoC par oreillette a terme).

CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y

# Role central (deja default=y, explicite ici pour la clarte du projet)
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n

# 2 canaux L2CAP CoC simultanes vises (aide gauche + aide droite)
CONFIG_BT_NIMBLE_L2CAP_COC_MAX_NUM=2

# Buffers mbuf — tailles reprises de l'exemple officiel (512 = coherent avec le MTU=512
# propose par Android observe dans le sniff HCI)
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=30
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_SIZE=512

# 3 connexions BLE simultanees suffisent pour 2 aides (defaut NimBLE = 3)
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3

# Taille flash — CE FICHIER EST PARTAGE ENTRE LES ENV xiao_esp32s3 ET xiao_esp32c3.
# Valeur actuelle = 4MB pour matcher le XIAO ESP32-C3 reellement utilise (verifie par
# esptool chip-id le 2026-09-12). Remettre a 8MB (CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y) si on
# rebascule sur un vrai XIAO ESP32-S3.
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=n
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
